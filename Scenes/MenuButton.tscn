[sub_resource type="GDScript" id="GDScript_s1yor"]
script/source = "extends Button

@export var scene : PackedScene

func _on_pressed() -> void:
	if scene != null:
		get_tree().change_scene_to_packed(scene)
	else:
		push_warning(\"ATENÇÃO!: Defina no Inspetor uma cena para este botão!\")
"

[node name="MenuButton" type="Button" unique_id=821937510]
offset_right = 100.0
offset_bottom = 42.0
size_flags_vertical = 3
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 30
theme_override_styles/normal = SubResource("StyleBoxFlat_7dm0k")
theme_override_styles/pressed = SubResource("StyleBoxFlat_1bvp3")
theme_override_styles/hover = SubResource("StyleBoxFlat_0xm2m")
text = "Button"
script = SubResource("GDScript_s1yor")

[connection signal="pressed" from="." to="." method="_on_pressed"]
